{
  "manifest_version": 3,
  "name": "HaySub — Տեղային ենթագրեր",
  "version": "1.3.0",
  "description": "Տեղային ենթագրեր և հայերեն թարգմանություն HaySub backend-ի միջոցով։",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "action": {"default_title": "HaySub ենթագրեր", "default_popup": "popup.html", "default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
    "js": ["core.js", "translation-client.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8000"}
}
