GEMINI_API_KEY=
# Choose a model available to your API key; see README verification command.
GEMINI_MODEL=
# Safety budgets persist across restarts; values can only lower the defaults.
# Flash Lite: 10 RPM, 400 requests per rolling 24 hours, 200000 estimated TPM.
# Other models: 3 RPM, 10 requests per rolling 24 hours, 200000 estimated TPM.
GEMINI_SAFE_RPM=10
GEMINI_SAFE_RPD=400
GEMINI_SAFE_TPM=200000

# Leave public mode off on your own computer. Deployment sets these on the server.
HAYSUB_PUBLIC=0
# Local library actions update catalog-site/catalog.json and public cover files.
# Commit/push catalog-site to GitHub separately to update the hosted static site.
HAYSUB_STATIC_CATALOG_SYNC=1
# HAYSUB_STATIC_CATALOG_DIR=C:/path/to/Armenian-subtitles/catalog-site
# HAYSUB_PUBLIC_URL=https://your-service.onrender.com
# HAYSUB_ADMIN_TOKEN=generate-a-random-password-at-least-32-characters
# HAYSUB_DB=/var/data/haysub.sqlite3
# HAYSUB_CONTACT_EMAIL=your-public-support-email
# HAYSUB_STORE_URL=https://chromewebstore.google.com/detail/your-extension-id

# Owner-hosted videos: leave unset to disable uploads with a clear setup message.
# HAYSUB_MEDIA_STORAGE=s3
# HAYSUB_S3_ENDPOINT=https://your-provider-s3-api-endpoint
# HAYSUB_S3_BUCKET=your-private-video-bucket
# HAYSUB_S3_REGION=your-provider-region
# HAYSUB_S3_ACCESS_KEY_ID=server-only-key
# HAYSUB_S3_SECRET_ACCESS_KEY=server-only-secret
# HAYSUB_S3_SESSION_TOKEN=optional-temporary-credential-token
# HAYSUB_S3_PREFIX=haysub-media
# HAYSUB_S3_ADDRESSING_STYLE=path
# HAYSUB_S3_VERSIONED=0
# Set VERSIONED=1 if bucket versioning is enabled; grant list/delete-version permissions.
# HAYSUB_MEDIA_MAX_BYTES=12884901888
# HAYSUB_MEDIA_PART_BYTES=67108864
# HAYSUB_UPLOAD_URL_SECONDS=900
# HAYSUB_PLAYBACK_TTL_SECONDS=14400
# HAYSUB_UPLOAD_IDLE_HOURS=48
# HAYSUB_MEDIA_WORKER_ENABLED=1
# HAYSUB_MEDIA_LEASE_SECONDS=900
# HAYSUB_FFPROBE=ffprobe
# HAYSUB_FFPROBE_TIMEOUT_SECONDS=120
# HAYSUB_FFPROBE_MEMORY_MB=512
# Local development only: never use this adapter for public hosting.
# HAYSUB_MEDIA_STORAGE=local
# HAYSUB_LOCAL_MEDIA_DIR=data/local-media
# HAYSUB_LOCAL_VIDEO_FOLDER=videos
# HAYSUB_LOCAL_MEDIA_SECRET=your-random-secret-with-at-least-32-characters

# Optional local flat library: use the same absolute data directory for both.
# HAYSUB_LOCAL_FLAT_LIBRARY=1
# HAYSUB_LIBRARY_ROOT=C:/path/to/Armenian-subtitles/data
# HAYSUB_LOCAL_MEDIA_DIR=C:/path/to/Armenian-subtitles/data
# HAYSUB_LOCAL_VIDEO_FOLDER=C:/path/to/Armenian-subtitles/data/videos

# Inactive cloud alternatives in player HTML; local tags stay active.
HAYSUB_CLOUD_BASE_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET_NAME>
# Use * to play all managed videos and subtitles from the cloud bucket.
# HAYSUB_CLOUD_VIDEO_IDS=*
# Hide selected entries from admin/public lists without deleting their files.
# HAYSUB_HIDDEN_VIDEO_IDS=comma-separated-video-ids
HAYSUB_CLOUD_PATH_PREFIX=data
